{
  "manifest_version": 3,
  "name": "1688 상품 캡처 → 로켓제안서",
  "version": "1.27.0",
  "description": "1688 상품 페이지의 URL/제조사/재질/사이즈/중량과, 옵션(색상 등)별 이름/가격, 그리고 수익 계산기로 계산한 원가/공급가/판매가를 클립보드로 복사해 로켓제안서 앱에 붙여넣을 수 있게 합니다. 통합다운으로 만든 견적서·이미지·라벨을 쿠팡 서플라이어허브 대량 상품 등록 화면에 자동으로 채워 넣기도 합니다.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "수익 계산기 (로켓제안서)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1688.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://rocket-product.vercel.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://supplier.coupang.com/*"
      ],
      "js": [
        "supplier.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://supplier.coupang.com/*"
      ],
      "js": [
        "hub-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
